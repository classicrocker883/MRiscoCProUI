# opt_set
# opt_disable
# opt_enable
# opt_add
exec_test $1 $2 "Aquila GD32 - ProUI X3" "$3"

use_example_configs "Voxelab Aquila/UBL"
opt_set CONTROLLERFAN_SPEED_MIN 40 CONTROLLERFAN_SPEED_MAX 127 \
        E0_AUTO_FAN_PIN UART5_TX_PIN CONTROLLER_FAN_PIN UART5_RX_PIN
