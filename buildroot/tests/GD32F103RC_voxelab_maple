opt_enable USE_CONTROLLER_FAN CONTROLLER_FAN_EDITABLE
opt_add FAN_KICKSTART_EDITABLE FAN_KICKSTART_MENU AUTO_FAN_EDITABLE AUTO_FAN_MENU
exec_test $1 $2 "Aquila GD32 - ProUI Unified (UBL) Adv Misc Fans" "$3"
